# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDE / editor
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Gauntlet artifacts (results, generated reports)
out/
results/
*.results.json

# Phase 2.5 T12 performance-benchmark sidecars. The scripts under
# scripts/perf/bench_*.py default to writing under benchmarks/*.json;
# the scripts and the docs are checked in, the actual numbers are not.
benchmarks/*.json

# Reference-benchmark artefacts. The script
# (scripts/generate_reference_benchmark.py) is checked in; the
# regenerable outputs (HTML reports, per-cell diffs, GH Pages bundle)
# are not — the benchmark.yml workflow attaches them to each GitHub
# Release as reference-benchmark.zip.
benchmarks/v*/
benchmarks/local/

# Drift-detector artefacts (trajectory dumps, AE weights).
# Test runs produce these under tmp paths but also land in ad-hoc local
# directories when users follow the quickstart; never commit them.
*.npz
*.pt
*.pth
*.safetensors
